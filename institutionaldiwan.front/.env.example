# Dev proxy target for the external ASP.NET Core API (see DEPLOYMENT.md).
# Falls back to ASPNETCORE_HTTPS_PORT, then https://localhost:7126.
DEV_PROXY_TARGET=https://localhost:7126

# Base URL the SPA uses for API calls. Keep relative so the dev proxy (or the
# production reverse proxy) supplies the origin; an absolute value would bypass
# the proxy and require CORS.
VITE_API_BASE_URL=/api
