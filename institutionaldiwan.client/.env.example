# Configuration template read by `vite.config.ts` and by the Vite build.
# Copy to `.env` and adjust — `.env` (and `.env.local`, `.env.<mode>`) are git-ignored.
#
# Two kinds of keys live here:
#   * plain keys (DEV_*) are read only by `vite.config.ts` for the dev server. They never reach
#     the browser bundle.
#   * `VITE_`-prefixed keys are embedded in the browser bundle at build time. Never put secrets in
#     them. Changing one requires a rebuild — restarting the deployed app is not enough.
#
# Real process/shell environment variables override these file values, so a one-off
# `DEV_SERVER_PORT=61422 npm run dev` (or the same variable in Visual Studio) wins over this file.

# Interface or hostname the dev server binds.
# Leave commented to keep Vite's default (localhost only, not reachable from other machines).
#   true             -> all interfaces (0.0.0.0 / ::), reachable via this machine's LAN address
#   192.168.1.10     -> bind exactly one address
#   diwan.dev.local  -> bind a custom hostname (also add it to DEV_ALLOWED_HOSTS)
#DEV_HOST=true

# Vite's host check: required whenever the address above is a custom hostname instead of
# localhost/an IP. Comma-separated hostnames, or `true` to accept any host header.
#DEV_ALLOWED_HOSTS=diwan.dev.local

# Port the dev server listens on (HTTPS). Previously the hardcoded default.
DEV_SERVER_PORT=61325

# Backend origin for the dev proxy (`^/api` and `^/hubs`). When set it takes precedence over the
# ASPNETCORE_HTTPS_PORT / ASPNETCORE_URLS shell variables and the `https://localhost:7126` fallback.
# Use an absolute URL with scheme and port, e.g. `http://192.168.1.20:5028` for a backend on the LAN.
#DEV_PROXY_TARGET=https://localhost:7126

# Public API base URL used by the browser client (`shared/api/httpClient`). Keep `/api` when the
# SPA and the API share an origin: the dev proxy locally, a reverse proxy in production. Set an
# absolute URL (for example `https://api.example.com/api`) only for a cross-origin API — that also
# requires CORS on the ASP.NET server for the SPA origin and the SignalR hub.
VITE_API_BASE_URL=/api
