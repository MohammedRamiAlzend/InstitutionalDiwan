@InstitutionalDiwan.Server_HostAddress = http://localhost:5028
@token = paste-a-valid-jwt-here

# Requires AUDIT_VIEW. Returns a PagedResult<AuditLogListItem>.
GET {{InstitutionalDiwan.Server_HostAddress}}/api/audit-logs?page=1&pageSize=20
Accept: application/json
Authorization: Bearer {{token}}

