<?xml version="1.0" encoding="utf-8"?>
<!--
  Publish profile: API + SPA over plain HTTP on port 4567.

  What it does on publish:
    1. npm ci (first run only) and npm run build in ..\institutionaldiwan.front
    2. copies institutionaldiwan.front\dist\* into this project's wwwroot (and into the output)
    3. seeds appsettings.Production.json in the output with "Urls": "http://0.0.0.0:4567"
       so `dotnet InstitutionalDiwan.Server.dll` binds there with no extra arguments

  Publish from the repo root:
    dotnet publish InstitutionalDiwan.Server -c Release -p:PublishProfile=Http-4567

  See Properties/README.md for the runtime environment variables (certificates, overrides).
-->
<Project>
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <_TargetId>Folder</_TargetId>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <LaunchSiteAfterPublish>false</LaunchSiteAfterPublish>
    <DeleteExistingFiles>true</DeleteExistingFiles>
    <PublishUrl>publish\Http-4567\</PublishUrl>
    <publishUrl>publish\Http-4567\</publishUrl>
    <PublishDir>$(MSBuildProjectDirectory)\publish\Http-4567\</PublishDir>

    <!-- SPA build: dist/ -> wwwroot inside the published API. -->
    <PublishFrontend>true</PublishFrontend>
    <!-- Relative, because the SPA is served by this same Kestrel instance. Set an absolute
         origin (e.g. https://diwan.example.org/api) only for a cross-origin deployment. -->
    <FrontendApiBaseUrl>/api</FrontendApiBaseUrl>
    <FrontendHubBaseUrl>/hubs</FrontendHubBaseUrl>

    <!-- Kestrel binding written into the published appsettings.Production.json. -->
    <PublishRuntimeUrls>http://0.0.0.0:4567</PublishRuntimeUrls>

    <!-- Generated next to the published assembly; sets the runtime environment and starts the app. -->
    <PublishScheme>http</PublishScheme>
    <PublishStartScriptName>start-http.cmd</PublishStartScriptName>
  </PropertyGroup>
</Project>
